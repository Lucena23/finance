# ═══════════════════════════════════════════════════════════════
# Finanças Aksurim — Backend Environment Variables (TEMPLATE)
# Copie para `.env` e preencha com valores reais.
# Este arquivo É versionável (não contém segredos).
# ═══════════════════════════════════════════════════════════════

# ─── Banco de Dados (MySQL 8 — Superdomínios / cPanel) ───
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL="mysql://usuario:senha@localhost:3306/financas_aksurim"

# ─── Autenticação JWT ───
# Chave secreta de 256 bits (64 caracteres hexadecimais).
JWT_SECRET="<chave-secreta-256-bits>"
JWT_EXPIRES_IN="7d"

# ─── Web Push (VAPID) ───
# Gere uma única vez com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="<chave-publica-vapid>"
VAPID_PRIVATE_KEY="<chave-privada-vapid>"
VAPID_SUBJECT="mailto:lucena@aksurim.com"

# ─── Runtime / Deploy ───
# PORT é injetada dinamicamente pelo cPanel Node.js App Manager (§8.11).
PORT=3000
NODE_ENV=development

# ─── Timezone (BRT/BRST) ───
TZ=America/Sao_Paulo
