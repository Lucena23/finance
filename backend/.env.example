# ═══════════════════════════════════════════════════════════════
# Finanças Aksurim — Backend Environment Variables (TEMPLATE)
# Copie para `.env` e preencha com valores reais.
# Este arquivo É versionável (não contém segredos).
# ═══════════════════════════════════════════════════════════════

# ─── Banco de Dados (MySQL 8 — Superdomínios / cPanel) ───
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL="mysql://usuario:senha@localhost:3306/financas_aksurim"

# ─── Autenticação JWT ───
# Chave secreta de 256 bits (64 caracteres hexadecimais).
JWT_SECRET="<chave-secreta-256-bits>"
JWT_EXPIRES_IN="7d"

# ─── Web Push (VAPID) ───
# Gere uma única vez com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="<chave-publica-vapid>"
VAPID_PRIVATE_KEY="<chave-privada-vapid>"
VAPID_SUBJECT="mailto:lucena@aksurim.com"

# ─── Runtime / Deploy ───
# PORT é injetada dinamicamente pelo cPanel Node.js App Manager (§8.11).
PORT=3000
NODE_ENV=development

# ─── Timezone (BRT/BRST) ───
TZ=America/Sao_Paulo

# ─── Suporte via Telegram (RN-14) ───
# Apenas o Backend fala com a API do Telegram. NUNCA expor no frontend.
# Obtenha o token via @BotFather e o chat id via @userinfobot.
TELEGRAM_BOT_TOKEN="<token-do-bot-telegram>"
TELEGRAM_CHAT_ID="<chat-id-do-suporte-aksurim>"

# ─── Admin Global (RN-15 / TAREFA 26) ───
# E-mail do Engenheiro Responsável promovido a Admin Global pelo seed
# `npm run seed:global-admin`. NÃO confundir com Role.ADMIN (chefe de família).
GLOBAL_ADMIN_EMAIL="lucena@aksurim.com"

# ─── Modelo Freemium (v1.2) ───
# Dias de teste gratuito concedidos no cadastro (padrão: 15).
TRIAL_DAYS=15
# Dias de tolerância após o vencimento antes de bloquear recursos Premium (padrão: 3).
PLAN_GRACE_DAYS=3
# Limite máximo de categorias no plano Gratuito (padrão: 5).
FREE_MAX_CATEGORIES=5

