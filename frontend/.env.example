# ═══════════════════════════════════════════
# Finanças Aksurim — Frontend (Vite)
# Copie para `.env` e preencha os valores. NUNCA versione o `.env` real.
# ═══════════════════════════════════════════

# URL base da API REST (prefixo /api/v1). Em dev, o proxy do Vite encaminha
# para http://localhost:3000. Em produção, use o domínio da API.
VITE_API_BASE_URL=/api/v1

# Chave PÚBLICA VAPID (base64url) para Web Push (TAREFA 49).
# Deve ser a MESMA chave pública configurada no backend (VAPID_PUBLIC_KEY).
# Gere com: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
