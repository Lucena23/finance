# ═══════════════════════════════════════════════════════════════
# Finanças Aksurim — .gitignore
# Blindagem de credenciais e documentação interna (REGRAS §2)
# ═══════════════════════════════════════════════════════════════

# Dependencies
/node_modules
/backend/node_modules
/frontend/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.pnp
.pnp.js

# Build outputs
/dist
/backend/dist
/frontend/dist
/out-tsc
/tmp

# Service Worker compilado (artefato gerado a partir de src/service-worker.ts)
/frontend/public/service-worker.js

# Environment (NUNCA versionar credenciais)
.env
.env.*
!.env.example
/backend/.env
/backend/.env.*
!/backend/.env.example

# Internal engineering docs (blindagem — NUNCA enviar ao GitHub)
/docs/

# IDE
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# Prisma
/backend/prisma/*.db

# Test coverage
/coverage
/backend/coverage
/frontend/coverage
