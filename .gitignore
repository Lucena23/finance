# ═══════════════════════════════════════════════════════════════
# Finanças Aksurim — .gitignore
# Blindagem de credenciais e documentação interna (REGRAS §2)
# ═══════════════════════════════════════════════════════════════

# Dependencies
/node_modules
/backend/node_modules
/frontend/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.pnp
.pnp.js

# Build outputs (backend/dist e frontend/dist são versionados para deploy instantâneo via SSH na Superdomínios)
/dist
/out-tsc
/tmp

# Relatórios de performance gerados (Lighthouse)
/frontend/lighthouse-reports/

# Environment (NUNCA versionar credenciais)
.env
.env.*
!.env.example
/backend/.env
/backend/.env.*
!/backend/.env.example

# Internal engineering docs (blindagem — NUNCA enviar ao GitHub)
/docs/

# IDE
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# Prisma
/backend/prisma/*.db

# Test coverage
/coverage
/backend/coverage
/frontend/coverage

# Artefatos temporários de build/empacotamento
*.tar.gz
query.js
test.js
.npmrc
